# ============================================================================
# PEPA THE OUTMAN — required production variables
#
# Copy to `.env.local` for development, or set them in the Vercel project
# settings for deployment. Never commit real values, never prefix a secret with
# NEXT_PUBLIC_.
# ============================================================================

# --- Supabase -------------------------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS and is used exclusively by server functions in
# src/lib/supabase/server.ts. NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Authentication -------------------------------------------------------
# The single authorized operator's password. Server-only, no NEXT_PUBLIC_
# prefix. Minimum 12 characters — the login gate refuses to run without it.
PEPA_PASSWORD=change-me-to-a-long-passphrase

# HMAC key used to sign the stateless session cookie. Server-only, no
# NEXT_PUBLIC_ prefix. Minimum 32 characters.
#   Generate with: openssl rand -base64 32
PEPA_SESSION_SECRET=generate-a-random-32-plus-character-secret

# --- Telegram (P1: notification channel + deep links) ---------------------
# Server-only. NEVER prefix these with NEXT_PUBLIC_ — a leaked bot token lets
# anyone impersonate the bot.
#
# Create a bot with @BotFather. TELEGRAM_CHAT_ID is your own user or chat id
# (message @userinfobot). Both are single-user private: only this chat is
# authorised to interact with PEPA.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-your-numeric-chat-id

# Shared secret Telegram echoes back in the `X-Telegram-Bot-Api-Secret-Token`
# header. Set it when registering the webhook, e.g.
#   curl -sS "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d url=https://pepa.example.com/api/telegram/webhook \
#     -d secret_token="$TELEGRAM_WEBHOOK_SECRET"
# The webhook rejects every delivery when this is missing.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret

# --- Follow-up scheduler (Vercel Cron) ------------------------------------
# Server-only shared secret that authorises GET /api/cron/followups. Vercel
# sends it as `Authorization: Bearer $CRON_SECRET` on every cron invocation, and
# the route compares it in constant time. The route fails closed (401) when it is
# unset — there is no development bypass.
#   Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-a-random-cron-secret

# --- Follow-up cadence (optional) -------------------------------------
# Business-day delays after each send, comma-separated. "2,4,7" means
# follow-up #1 is due 2 business days after the previous email was
# actually sent, #2 after 4, #3 after 7. Saturdays and Sundays never
# count; days are decided in Europe/Prague. Unset or invalid values
# fall back to the default cadence (4,7,10).
# PEPA_FOLLOWUP_CADENCE=4,7,10

# --- ChatGPT import ------------------------------------------------------
# Server-only bearer secret for POST /api/import, the hand-off point for an
# email generated outside PEPA (a ChatGPT action, a script, curl). Compared in
# constant time; the route fails closed (401) when it is unset. The response is
# only ever a short-lived opaque link — never the payload, never a lead id.
#   Generate with: openssl rand -base64 32
IMPORT_SECRET=replace-with-a-random-import-secret

# --- Optional -------------------------------------------------------------
# Canonical public origin for deep links. Falls back to the request host, which
# is correct on Vercel.
PEPA_BASE_URL=https://pepa.example.com

# Enables the "Test Telegram" button in production builds. Off by default.
PEPA_ENABLE_DEV_TOOLS=false

# --- Later (not implemented, placeholders only) ---------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template holds placeholder values only and is referenced by runtime error
# messages, the setup notice and the deployment runbook, so it must be tracked.
!.env.example

# vercel
.vercel

# Kilo agent worktrees and Agent Manager state. These are local tooling, not
# application source: a worktree is a full duplicate of the project (possibly at
# an older commit, missing migrations) and must never be committed.
.kilo/

# typescript
*.tsbuildinfo
next-env.d.ts

# Legacy outreach export (pepa_outreach_history_detailed.csv / .txt)
# Real prospect addresses from the previous business account. Source of truth
# for `npm run import:historical-outreach`, but it must never enter git history:
# once committed it stays there. The database is the system of record.
pepa_outreach_history_detailed.csv
pepa_outreach_history_detailed.txt

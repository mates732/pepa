{
  "$schema": "https://vercel.sh/vercel.json",
  "buildCommand": "npm install --legacy-peer-deps && npm run build",
  "crons": [
    {
      "path": "/api/cron/followups",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/streak-reminders",
      "schedule": "0 18 * * *"
    }
  ]
}
